# Python
__pycache__/
*.pyc
*.pyo
_wheels/

# Model weights — only ship best deployment models
*.pt
!artifacts/checkpoints/best_model_v1.pt
!artifacts/checkpoints/best_model_v2.pt
*.onnx
!artifacts/checkpoints/best_model_v2.onnx

# Dataset (large files, downloaded separately — see src/data/download.py)
data/raw/
data/annotations/wider_face_split/
# Generated image lists (absolute paths, machine specific)
data/annotations/*_list.txt

# Training intermediates (regenerated on every run)
artifacts/checkpoints/*/weights/
artifacts/checkpoints/**/train_batch*.jpg
artifacts/logs/
runs/

# Runtime artifacts (local demo outputs, regenerated on each run)
/output_result.mp4
/screenshot_*.jpg
/results/

# Delivery bundle (regenerated after the project is finalized)
/高精度人脸检测/
/高精度人脸检测.zip

# System
.DS_Store
.claude/settings.local.json

# Generated reports (not source code)
*.doc
*.docx
