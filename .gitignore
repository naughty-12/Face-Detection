# Python
__pycache__/
*.pyc
*.pyo
_wheels/

# Model weights — only ship best deployment models
*.pt
!training/checkpoints/best_model_v1.pt
!training/checkpoints/best_model_v2.pt
*.onnx
!training/checkpoints/best_model_v2.onnx

# Dataset (large files, downloaded separately — see data/download_widerface.py)
data/raw/
data/annotations/wider_face_split/

# Training intermediate weights (best copies already saved at checkpoints/best_model_*.pt)
training/checkpoints/*/weights/
# Training batch debug images (regenerated on every training run)
training/checkpoints/**/train_batch*.jpg
training/training_log.txt
runs/

# Runtime artifacts (local demo outputs, regenerated on each run)
/output_result.mp4
/screenshot_*.jpg
/results/

# Delivery bundle (regenerated after the project is finalized)
/高精度人脸检测/
/高精度人脸检测.zip

# System
.DS_Store
.claude/settings.local.json

# Generated reports (not source code)
*.doc
*.docx
