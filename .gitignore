# Python
__pycache__/
*.pyc
*.pyo
_wheels/

# C# static-check build output (see apps/unity_link/CompileCheck/check.ps1)
apps/unity_link/CompileCheck/bin/
apps/unity_link/CompileCheck/obj/

# Model weights — only ship best deployment models
*.pt
!artifacts/checkpoints/best_model_v1.pt
!artifacts/checkpoints/best_model_v2.pt
*.onnx
!artifacts/checkpoints/best_model_v2.onnx

# Dataset (large files, downloaded separately — see src/data/download.py)
data/raw/
data/annotations/wider_face_split/
# Generated image lists (absolute paths, machine specific)
data/annotations/*_list.txt

# Training intermediates (regenerated on every run)
artifacts/checkpoints/*/weights/
artifacts/checkpoints/**/train_batch*.jpg
artifacts/logs/
runs/

# Runtime artifacts (local demo outputs, regenerated on each run)
/output_result.mp4
/screenshot_*.jpg
/results/

# Large generated visualisations (multi-MB image grids; regenerate with
# python -m src.eval.analyze_errors)
artifacts/reports/fn_visualization.png
artifacts/reports/fp_visualization.png

# Delivery bundle (regenerated after the project is finalized)
/高精度人脸检测/
/高精度人脸检测.zip

# System
.DS_Store
.claude/settings.local.json

# Unit-test scratch directories
/.facetest_tmp_*/
/.facetest_*/
/facetest_*/
/_wtest_*/
artifacts/diag/_wtest_*/

# Live-camera captures: the raw frame and the face crop contain the person sitting
# at the camera. Diagnostic only, never evidence -- keep them out of the repository.
artifacts/diag/camera_frame.png
artifacts/diag/bridge_crop.png

# Generated reports (not source code)
*.doc
*.docx
